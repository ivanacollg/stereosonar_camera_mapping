Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1/Tree1
        - /MarkerArray1/Status1
      Splitter Ratio: 0.44999998807907104
    Tree Height: 768
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: RawImage
  - Class: graph_rviz_plugin/Line graph
    Name: Line graph
    export_directory: ""
    legend_enable: true
    refresh_freq: 40
    topic_0_color: 0
    topic_0_name: /altitude
    topic_0_thickness: 1
    topic_0_type: std_msgs/Float64
    topic_1_color: 1
    topic_1_name: /velocity_x
    topic_1_thickness: 1
    topic_1_type: std_msgs/Float64
    topic_2_color: 2
    topic_2_name: /velocity_y
    topic_2_thickness: 1
    topic_2_type: std_msgs/Float64
    topic_3_color: 3
    topic_3_name: /velocity_z
    topic_3_thickness: 1
    topic_3_type: std_msgs/Float64
    w_time: 1
    window_time_enable: false
    y_max: 10
    y_min: 0
    yaxis_rescale_auto: true
  - Class: graph_rviz_plugin/Line graph
    Name: Line graph
    export_directory: ""
    legend_enable: true
    refresh_freq: 40
    topic_0_color: 0
    topic_0_name: /depth
    topic_0_thickness: 1
    topic_0_type: std_msgs/Float32
    topic_1_color: 1
    topic_1_name: /velocity_x
    topic_1_thickness: 1
    topic_1_type: std_msgs/Float64
    topic_2_color: 2
    topic_2_name: /velocity_y
    topic_2_thickness: 1
    topic_2_type: std_msgs/Float64
    topic_3_color: 3
    topic_3_name: /velocity_z
    topic_3_thickness: 1
    topic_3_type: std_msgs/Float64
    w_time: 1
    window_time_enable: false
    y_max: 10
    y_min: 0
    yaxis_rescale_auto: true
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
